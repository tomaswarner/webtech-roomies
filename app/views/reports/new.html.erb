<% content_for :title, "Report #{@listing.title}" %>
<%= render "shared/page_header", title: "Report this listing", subtitle: @listing.title %>

<div class="container" style="max-width: 720px">
  <%= form_with model: [ @listing, @report ], class: "card card-body shadow-sm" do |f| %>
    <%= render "shared/base_errors", record: @report %>
    <div class="mb-3">
      <%= f.label :reason, class: "form-label" %>
      <%= f.select :reason, Report::REASONS.map { |reason| [ reason.humanize, reason ] }, { include_blank: "Choose a reason" },
                   required: true, class: field_class(f, :reason, "form-select") %>
      <%= field_errors(f, :reason) %>
    </div>
    <div class="mb-3">
      <%= f.label :details, class: "form-label" %>
      <%= f.text_area :details, rows: 4, placeholder: "What looks wrong with this listing?", class: field_class(f, :details) %>
      <%= field_errors(f, :details) %>
    </div>
    <div class="d-flex gap-2">
      <%= f.submit "Send report", class: "btn btn-danger" %>
      <%= link_to "Cancel", @listing, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
</div>
