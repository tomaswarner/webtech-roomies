<% content_for :title, @amenity.name %>
<%= render "shared/page_header", title: @amenity.name, subtitle: "#{pluralize(@properties.size, 'property')} with this amenity" %>

<div class="container">
  <div class="d-flex gap-2 justify-content-end mb-3">
    <%= link_to "Edit", edit_amenity_path(@amenity), class: "btn btn-outline-primary" %>
    <%= button_to "Delete", @amenity, method: :delete, class: "btn btn-outline-danger",
                  form: { data: { turbo_confirm: "Delete #{@amenity.name}?" } } %>
  </div>
  <% if @properties.any? %>
    <ul class="list-group">
      <% @properties.each do |property| %>
        <li class="list-group-item"><%= link_to property.to_s, property %></li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/empty_state", message: "No property offers #{@amenity.name} yet.", icon: "stars" %>
  <% end %>
</div>
