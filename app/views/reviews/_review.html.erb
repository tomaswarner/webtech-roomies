<div class="border-bottom py-3">
  <div class="d-flex justify-content-between align-items-center mb-1">
    <strong><%= review.seeker.name %></strong>
    <%= rating_stars(review.rating) %>
  </div>
  <p class="mb-1"><%= review.comment %></p>
  <div class="d-flex justify-content-between align-items-center">
    <p class="small text-muted mb-0">Visited <%= time_ago_in_words(review.created_at) %> ago</p>
    <% if current_user && review.seeker_id == current_user.id %>
      <div class="d-flex gap-2">
        <%= link_to "Edit", edit_review_path(review), class: "btn btn-sm btn-link" %>
        <%= button_to "Delete", review, method: :delete, class: "btn btn-sm btn-link text-danger",
                      form: { data: { turbo_confirm: "Delete your review?" } } %>
      </div>
    <% end %>
  </div>
</div>
