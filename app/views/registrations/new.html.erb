<% content_for :title, "Sign up" %>
<%= render "shared/page_header", title: "Sign up", subtitle: "Publish your room or apply to one" %>

<div class="container" style="max-width: 560px">
  <%= form_with model: @user, url: registration_path, class: "card card-body shadow-sm" do |f| %>
    <%= render "shared/base_errors", record: @user %>
    <div class="mb-3">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, required: true, autofocus: true, autocomplete: "name", class: field_class(f, :name) %>
      <%= field_errors(f, :name) %>
    </div>
    <div class="mb-3">
      <%= f.label :email, "Email address", class: "form-label" %>
      <%= f.email_field :email, required: true, autocomplete: "username", class: field_class(f, :email) %>
      <%= field_errors(f, :email) %>
    </div>
    <div class="mb-3">
      <%= f.label :phone, "Phone (optional)", class: "form-label" %>
      <%= f.telephone_field :phone, autocomplete: "tel", placeholder: "+56 9 1234 5678", class: field_class(f, :phone) %>
      <%= field_errors(f, :phone) %>
    </div>
    <div class="mb-3">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: field_class(f, :password) %>
      <%= field_errors(f, :password) %>
    </div>
    <div class="mb-3">
      <%= f.label :password_confirmation, "Repeat the password", class: "form-label" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
                           class: field_class(f, :password_confirmation) %>
      <%= field_errors(f, :password_confirmation) %>
    </div>
    <%= f.submit "Create account", class: "btn btn-primary w-100" %>
  <% end %>

  <p class="mt-3 text-center">Already have an account? <%= link_to "Sign in", new_session_path %></p>
</div>
