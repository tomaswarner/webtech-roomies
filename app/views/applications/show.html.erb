<% content_for :title, "Application from #{@application.seeker.name}" %>
<%= render "shared/page_header", title: "Application from #{@application.seeker.name}",
           subtitle: "For #{@listing.title}" %>

<div class="container">
  <div class="row g-4">
    <div class="col-lg-7">
      <h2 class="h4">Message</h2>
      <blockquote class="border-start border-4 ps-3"><%= @application.message %></blockquote>
      <dl class="row mt-4">
        <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><%= status_badge(@application.status) %></dd>
        <dt class="col-sm-4">Move-in date</dt><dd class="col-sm-8"><%= l(@application.move_in_date, format: :long) %></dd>
        <dt class="col-sm-4">Stay</dt><dd class="col-sm-8"><%= stay_text(@application.stay_duration_months) %></dd>
        <dt class="col-sm-4">Seeker</dt><dd class="col-sm-8"><%= @application.seeker.name %></dd>
        <dt class="col-sm-4">Sent</dt><dd class="col-sm-8"><%= l(@application.created_at, format: :long) %></dd>
      </dl>

      <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
        <h2 class="h4 mb-0">Visits</h2>
        <% if @application.shortlisted? %>
          <%= link_to new_application_visit_path(@application), class: "btn btn-sm btn-primary" do %><i class="bi bi-calendar-plus"></i> Propose a visit<% end %>
        <% end %>
      </div>
      <% if @application.visits.any? %>
        <ul class="list-group">
          <% @application.visits.each do |visit| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span><i class="bi bi-calendar-event"></i> <%= l(visit.scheduled_at, format: :long) %></span>
              <span class="d-flex flex-wrap align-items-center gap-1">
                <%= status_badge(visit.status) %>
                <% if visit.proposed? %>
                  <%= button_to "Confirm", visit, method: :patch, params: { visit: { status: "confirmed" } },
                                class: "btn btn-sm btn-outline-primary" %>
                <% end %>
                <% if visit.open? %>
                  <%= link_to "Reschedule", edit_visit_path(visit), class: "btn btn-sm btn-outline-secondary" %>
                  <%= button_to "Cancel", visit, method: :patch, params: { visit: { status: "cancelled" } },
                                class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Cancel this visit?" } %>
                <% end %>
                <% if visit.confirmed? %>
                  <%= button_to "Mark as completed", visit, method: :patch, params: { visit: { status: "completed" } },
                                class: "btn btn-sm btn-success" %>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/empty_state", message: "No visits have been scheduled.", icon: "calendar-x" %>
      <% end %>
    </div>

    <aside class="col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="h5"><%= link_to @listing.title, @listing %></h2>
          <p class="text-muted small mb-2"><%= @listing.property %></p>
          <p class="fw-semibold mb-1"><%= money(@listing.monthly_rent) %> / month</p>
          <p class="mb-2"><%= status_badge(@listing.status) %></p>
          <p class="small mb-0">Host: <%= @listing.property.host.name %></p>
        </div>
      </div>
    </aside>
  </div>
</div>
