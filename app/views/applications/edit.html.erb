<% content_for :title, "Edit application" %>
<%= render "shared/page_header", title: "Edit your application", subtitle: "For #{@application.listing.title}" %>

<div class="container" style="max-width: 720px">
  <%= form_with model: @application, class: "card card-body shadow-sm" do |f| %>
    <%= render "shared/base_errors", record: @application %>
    <div class="mb-3">
      <%= f.label :message, "Introduce yourself", class: "form-label" %>
      <%= f.text_area :message, rows: 5, required: true, class: field_class(f, :message) %>
      <%= field_errors(f, :message) %>
    </div>
    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <%= f.label :move_in_date, "Move-in date", class: "form-label" %>
        <%= f.date_field :move_in_date, required: true, class: field_class(f, :move_in_date) %>
        <%= field_errors(f, :move_in_date) %>
      </div>
      <div class="col-md-6">
        <%= f.label :stay_duration_months, "Intended stay (months)", class: "form-label" %>
        <%= f.number_field :stay_duration_months, required: true, min: @application.listing.minimum_stay_months, step: 1,
                           class: field_class(f, :stay_duration_months) %>
        <%= field_errors(f, :stay_duration_months) %>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= f.submit "Update application", class: "btn btn-primary" %>
      <%= link_to "Cancel", @application, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
</div>
