<div class="card h-100 shadow-sm listing-card">
  <div class="position-relative">
    <% if (photo = listing.cover_photo) %>
      <%= image_tag photo.variant(:card), alt: listing.title, class: "card-img-top listing-photo", loading: "lazy" %>
    <% else %>
      <%= render "shared/photo_placeholder" %>
    <% end %>
    <% unless listing.published? %>
      <span class="position-absolute top-0 start-0 m-2"><%= status_badge(listing.status) %></span>
    <% end %>
  </div>
  <div class="card-body d-flex flex-column">
    <p class="small text-uppercase text-muted mb-1">
      <i class="bi bi-geo-alt"></i> <%= listing.property.neighborhood.name %>
    </p>
    <h3 class="card-title h5">
      <%= link_to listing.title, listing, class: "stretched-link text-reset text-decoration-none" %>
    </h3>
    <p class="card-text fw-semibold mb-1"><%= money(listing.monthly_rent) %> <span class="fw-normal text-muted">/ month</span></p>
    <p class="card-text text-muted small mb-2"><%= availability_text(listing) %></p>
    <p class="card-text small text-muted mt-auto mb-0">
      <i class="bi bi-house-door"></i> <%= listing.property.address %>
    </p>
  </div>
</div>
