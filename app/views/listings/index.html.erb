<% content_for :title, "Search rooms" %>
<%= render "shared/page_header", title: "Search rooms", subtitle: "Published rooms in shared homes" %>

<div class="container" data-controller="listing-search" data-listing-search-url-value="<%= api_v1_listings_path %>">
  <%= render "listings/search_form", neighborhoods: @neighborhoods, amenities: @amenities, live: true %>

  <p class="text-muted small mt-4 mb-2" data-listing-search-target="status" role="status" aria-live="polite">Loading rooms...</p>
  <div class="row g-4" data-listing-search-target="results"></div>
</div>
