<% content_for :title, "Search rooms" %>
<%= render "shared/page_header", title: "Search rooms", subtitle: "Published rooms in shared homes" %>

<div class="container">
  <%= render "listings/search_form", neighborhoods: @neighborhoods %>

  <div class="mt-4">
    <% if @listings.any? %>
      <div class="row g-4">
        <% @listings.each do |listing| %>
          <div class="col-md-6 col-lg-4"><%= render listing %></div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "No rooms match your search.", icon: "search" %>
    <% end %>
  </div>
</div>
