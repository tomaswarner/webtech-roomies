<% content_for :title, "Update your password" %>
<%= render "shared/page_header", title: "Update your password" %>

<div class="container" style="max-width: 480px">
  <%= form_with url: password_path(params[:token]), method: :put, class: "card card-body shadow-sm" do |form| %>
    <div class="mb-3">
      <%= form.label :password, "New password", class: "form-label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= form.label :password_confirmation, "Repeat the new password", class: "form-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "form-control" %>
    </div>
    <%= form.submit "Save", class: "btn btn-primary w-100" %>
  <% end %>
</div>
