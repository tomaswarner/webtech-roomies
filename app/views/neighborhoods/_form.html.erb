<%= form_with model: neighborhood, class: "card card-body shadow-sm" do |f| %>
  <%= render "shared/base_errors", record: neighborhood %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, required: true, maxlength: 80, placeholder: "e.g. Providencia", class: field_class(f, :name) %>
    <%= field_errors(f, :name) %>
  </div>
  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", neighborhood.persisted? ? neighborhood : neighborhoods_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
