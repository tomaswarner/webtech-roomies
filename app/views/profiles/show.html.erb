<% content_for :title, "Your profile" %>
<%= render "shared/page_header", title: @user.name, subtitle: (@user.moderator? ? "Moderator" : "Member") %>

<div class="container" style="max-width: 720px">
  <div class="card card-body shadow-sm">
    <dl class="row mb-0">
      <dt class="col-sm-3">Email</dt><dd class="col-sm-9"><%= @user.email %></dd>
      <dt class="col-sm-3">Phone</dt><dd class="col-sm-9"><%= @user.phone.presence || tag.span("Not set", class: "text-muted") %></dd>
      <dt class="col-sm-3">Bio</dt>
      <dd class="col-sm-9 mb-0"><%= @user.bio.present? ? simple_format(@user.bio, class: "mb-0") : tag.span("You have not written a bio yet.", class: "text-muted") %></dd>
    </dl>
  </div>
  <div class="mt-3">
    <%= link_to "Edit profile", edit_profile_path, class: "btn btn-primary" %>
  </div>
</div>
