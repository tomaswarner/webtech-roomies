<% content_for :title, "Not allowed" %>
<%= render "shared/page_header", title: "You are not allowed to do that" %>

<div class="container" style="max-width: 720px">
  <div class="alert alert-warning d-flex gap-3 align-items-start" role="alert">
    <i class="bi bi-shield-lock fs-3"></i>
    <div>
      <p class="mb-1"><%= @reason %></p>
      <p class="small mb-0">Nothing was changed.</p>
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Go to the home page", root_path, class: "btn btn-primary" %>
    <% if current_user %>
      <%= link_to "Your applications", applications_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
</div>
