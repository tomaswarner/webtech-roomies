<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <%= link_to "Roomies", root_path, class: "navbar-brand fw-bold" %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><%= nav_link_to "Search", listings_path %></li>
        <li class="nav-item"><%= nav_link_to "Properties", properties_path %></li>
        <% if current_user %>
          <li class="nav-item"><%= nav_link_to "Neighborhoods", neighborhoods_path %></li>
          <li class="nav-item"><%= nav_link_to "Amenities", amenities_path %></li>
          <li class="nav-item"><%= nav_link_to "Applications", applications_path %></li>
          <% if policy(Report).index? %>
            <li class="nav-item"><%= nav_link_to "Reports", reports_path %></li>
          <% end %>
        <% end %>
      </ul>
      <div class="d-flex align-items-center gap-2 ms-lg-3 mt-2 mt-lg-0">
        <% if current_user %>
          <%= link_to profile_path, class: "btn btn-sm btn-outline-light" do %>
            <i class="bi bi-person-circle"></i> <%= current_user.first_name %>
            <% if current_user.moderator? %><span class="badge text-bg-warning ms-1">Moderator</span><% end %>
          <% end %>
          <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-sm btn-light" %>
        <% else %>
          <%= link_to "Sign in", new_session_path, class: "btn btn-sm btn-outline-light" %>
          <%= link_to "Sign up", new_registration_path, class: "btn btn-sm btn-light" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
