<%= form_with model: property, class: "card card-body shadow-sm" do |f| %>
  <%= render "shared/base_errors", record: property %>
  <div class="mb-3">
    <%= f.label :address, class: "form-label" %>
    <%= f.text_field :address, required: true, placeholder: "Av. Providencia 1650, depto. 1204", class: field_class(f, :address) %>
    <%= field_errors(f, :address) %>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :neighborhood_id, "Neighborhood", class: "form-label" %>
      <%= f.collection_select :neighborhood_id, Neighborhood.by_name, :id, :name, { prompt: "Choose a neighborhood" },
                              required: true, class: field_class(f, :neighborhood_id, "form-select") %>
      <%= field_errors(f, :neighborhood_id) %>
    </div>
    <div class="col-md-6">
      <%= f.label :property_type, class: "form-label" %>
      <%= f.select :property_type, Property::PROPERTY_TYPES.map { |type| [ type.humanize, type ] }, { prompt: "Choose a type" },
                   required: true, class: field_class(f, :property_type, "form-select") %>
      <%= field_errors(f, :property_type) %>
    </div>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :bedrooms_count, "Bedrooms", class: "form-label" %>
      <%= f.number_field :bedrooms_count, required: true, min: 1, step: 1, placeholder: "3", class: field_class(f, :bedrooms_count) %>
      <%= field_errors(f, :bedrooms_count) %>
    </div>
    <div class="col-md-6">
      <%= f.label :bathrooms_count, "Bathrooms", class: "form-label" %>
      <%= f.number_field :bathrooms_count, required: true, min: 1, step: 1, placeholder: "2", class: field_class(f, :bathrooms_count) %>
      <%= field_errors(f, :bathrooms_count) %>
    </div>
  </div>
  <div class="mb-3">
    <%= f.label :shared_spaces_description, "Shared spaces", class: "form-label" %>
    <%= f.text_area :shared_spaces_description, rows: 3, placeholder: "Living room with a balcony, fully equipped kitchen, laundry corner...",
                    class: field_class(f, :shared_spaces_description) %>
    <%= field_errors(f, :shared_spaces_description) %>
  </div>
  <fieldset class="mb-3">
    <legend class="form-label fs-6">Amenities</legend>
    <div class="row">
      <%= f.collection_check_boxes :amenity_ids, Amenity.by_name, :id, :name do |b| %>
        <div class="col-sm-6 col-md-4">
          <div class="form-check">
            <%= b.check_box class: "form-check-input" %>
            <%= b.label class: "form-check-label" %>
          </div>
        </div>
      <% end %>
    </div>
  </fieldset>
  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", property.persisted? ? property : properties_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
